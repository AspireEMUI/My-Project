# Example environment variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe (if using payment processing)
VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXX
VITE_STRIPE_SECRET_KEY=sk_test_XXXXXXXX

# Email Service (Mailchimp, ConvertKit, etc.)
VITE_MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_MAILCHIMP_LIST_ID=xxxxxxxx
VITE_MAILCHIMP_FORM_ACTION=https://your-domain.us1.list-manage.com/subscribe/post

# Email Settings
VITE_CONTACT_EMAIL=support@your-domain.com
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_PASSWORD=your-app-password

# API Endpoints
VITE_API_BASE_URL=https://api.your-domain.com
VITE_CHECKOUT_URL=https://checkout.your-domain.com

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_CHAT=false
VITE_ENABLE_REVIEWS=true

# Environment
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=false

# Site Configuration
VITE_SITE_NAME=Lumineux Beauty
VITE_SITE_URL=https://your-domain.com
VITE_SITE_DESCRIPTION=Premium, cruelty-free cosmetics

# Social Media
VITE_INSTAGRAM_URL=https://instagram.com/your-handle
VITE_TIKTOK_URL=https://tiktok.com/@your-handle
VITE_FACEBOOK_URL=https://facebook.com/your-page

# Currency
VITE_CURRENCY=USD
VITE_CURRENCY_SYMBOL=$
